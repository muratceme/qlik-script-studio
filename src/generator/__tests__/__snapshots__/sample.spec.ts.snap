// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`sample project > validates and matches the snapshot 1`] = `
"///$tab Main
// Generated by Qlik Script Studio (https://github.com/muratceme/qlik-script-studio)
// Project: Sales demo
// This script is generated from a visual model. Edit the model and regenerate instead of editing by hand.

// Regional settings (EN)
SET ThousandSep=',';
SET DecimalSep='.';
SET MoneyThousandSep=',';
SET MoneyDecimalSep='.';
SET MoneyFormat='$#,##0.00;-$#,##0.00';
SET TimeFormat='h:mm:ss TT';
SET DateFormat='M/D/YYYY';
SET TimestampFormat='M/D/YYYY h:mm:ss[.fff] TT';
SET FirstWeekDay=6;
SET BrokenWeeks=1;
SET ReferenceDay=0;
SET FirstMonthOfYear=1;
SET CollationLocale='en-US';
SET MonthNames='Jan;Feb;Mar;Apr;May;Jun;Jul;Aug;Sep;Oct;Nov;Dec';
SET LongMonthNames='January;February;March;April;May;June;July;August;September;October;November;December';
SET DayNames='Mon;Tue;Wed;Thu;Fri;Sat;Sun';
SET LongDayNames='Monday;Tuesday;Wednesday;Thursday;Friday;Saturday;Sunday';

///$tab Sources
// Sales (QVD)
Sales:
LOAD
    OrderID,
    OrderDate,
    CustomerID,
    ProductID,
    Quantity,
    [Sales Amount],
    Status
FROM [lib://DataFiles/Sales.qvd] (qvd);

// Products (CSV)
Products:
LOAD
    ProductID,
    [Product Name],
    Category,
    [Unit Price]
FROM [lib://DataFiles/Products.csv] (txt, utf8, embedded labels, delimiter is ';', msq);

// Regions (Inline)
Regions:
LOAD * INLINE [
RegionCode, RegionName
TR, Türkiye
EU, Europe
US, United States
];

// Mapping Map_Region: RegionCode -> RegionName
Map_Region:
MAPPING LOAD
    RegionCode,
    RegionName
RESIDENT Regions;

// Customers (Excel)
Customers:
LOAD
    CustomerID,
    [Customer Name],
    City,
    RegionCode,
    Date(Date#([Customer Since], 'DD.MM.YYYY'))   AS CustomerSince,
    ApplyMap('Map_Region', RegionCode, 'Unknown') AS Region
FROM [lib://DataFiles/Customers.xlsx] (ooxml, embedded labels, table is Customers);

///$tab Transform
// Fact_Sales (from Sales)
Fact_Sales:
NoConcatenate
LOAD
    OrderID,
    OrderDate,
    CustomerID,
    ProductID,
    Quantity,
    [Sales Amount],
    Status,
    Year(OrderDate)                              AS OrderYear,
    If(Quantity <> 0, [Sales Amount] / Quantity) AS [Avg Unit Price]
RESIDENT Sales
WHERE Status <> 'Cancelled';

// Sales_By_Customer (from Sales)
Sales_By_Customer:
NoConcatenate
LOAD
    CustomerID              AS CustomerID_Agg,
    Sum([Sales Amount])     AS [Total Sales],
    Count(DISTINCT OrderID) AS [Order Count]
RESIDENT Sales
GROUP BY CustomerID;

///$tab Calendar
// Master calendar for Fact_Sales.OrderDate
Calendar_Range:
LOAD
    Min(Floor(OrderDate)) AS MinDate,
    Max(Floor(OrderDate)) AS MaxDate
RESIDENT Fact_Sales;

LET vMinDate = Num(Peek('MinDate', 0, 'Calendar_Range'));
LET vMaxDate = Num(Peek('MaxDate', 0, 'Calendar_Range'));
DROP TABLE Calendar_Range;

Calendar:
LOAD
    OrderDate,
    Year(OrderDate)                        AS Year,
    'Q' & Ceil(Month(OrderDate) / 3)       AS Quarter,
    Month(OrderDate)                       AS Month,
    MonthName(OrderDate)                   AS MonthName,
    Week(OrderDate)                        AS Week,
    Day(OrderDate)                         AS Day,
    WeekDay(OrderDate)                     AS WeekDay,
    Date(MonthStart(OrderDate), 'YYYY-MM') AS YearMonth
;
LOAD
    Date($(vMinDate) + IterNo() - 1) AS OrderDate
AUTOGENERATE 1
WHILE $(vMinDate) + IterNo() - 1 <= $(vMaxDate);

LET vMinDate = Null();
LET vMaxDate = Null();

///$tab Store
// Store Fact_Sales as QVD
STORE Fact_Sales INTO [lib://QVD/Fact_Sales.qvd] (qvd);

///$tab Cleanup
// Drop temporary tables that were only used to build the final model
DROP TABLE Sales;
DROP TABLE Regions;
"
`;
