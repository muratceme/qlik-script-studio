// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`links > ApplyMap: mapping table after its source, mapped field in the left load, default value 1`] = `
"///$tab Main
// Generated by Script Studio for Qlik (https://github.com/muratceme/qlik-script-studio)
// Project: Test
// This script is generated from a visual model. Edit the model and regenerate instead of editing by hand.

// Regional settings (EN)
SET ThousandSep=',';
SET DecimalSep='.';
SET MoneyThousandSep=',';
SET MoneyDecimalSep='.';
SET MoneyFormat='$#,##0.00;-$#,##0.00';
SET TimeFormat='h:mm:ss TT';
SET DateFormat='M/D/YYYY';
SET TimestampFormat='M/D/YYYY h:mm:ss[.fff] TT';
SET FirstWeekDay=6;
SET BrokenWeeks=1;
SET ReferenceDay=0;
SET FirstMonthOfYear=1;
SET CollationLocale='en-US';
SET MonthNames='Jan;Feb;Mar;Apr;May;Jun;Jul;Aug;Sep;Oct;Nov;Dec';
SET LongMonthNames='January;February;March;April;May;June;July;August;September;October;November;December';
SET DayNames='Mon;Tue;Wed;Thu;Fri;Sat;Sun';
SET LongDayNames='Monday;Tuesday;Wednesday;Thursday;Friday;Saturday;Sunday';

///$tab Sources
// Sales (QVD)
Sales:
LOAD
    OrderID,
    CustomerID,
    ProductID,
    OrderDate,
    Amount
FROM [lib://DataFiles/Sales.qvd] (qvd);

// Products (QVD)
Products:
LOAD
    ProductID,
    [Product Name],
    Region
FROM [lib://DataFiles/Products.qvd] (qvd);

// Regions (Inline)
Regions:
LOAD * INLINE [
RegionCode, RegionName
TR, Türkiye
];

// Mapping Map_Region: RegionCode -> RegionName
Map_Region:
MAPPING LOAD
    RegionCode,
    RegionName
RESIDENT Regions;

// Customers (QVD)
Customers:
LOAD
    CustomerID,
    [Customer Name],
    Region,
    ApplyMap('Map_Region', Region, 'Unknown') AS [Region Name]
FROM [lib://DataFiles/Customers.qvd] (qvd);

///$tab Cleanup
// Drop temporary tables that were only used to build the final model
DROP TABLE Regions;
"
`;

exports[`links > composite keys: concat and AutoNumber on both sides of a join 1`] = `
"///$tab Main
// Generated by Script Studio for Qlik (https://github.com/muratceme/qlik-script-studio)
// Project: Test
// This script is generated from a visual model. Edit the model and regenerate instead of editing by hand.

// Regional settings (EN)
SET ThousandSep=',';
SET DecimalSep='.';
SET MoneyThousandSep=',';
SET MoneyDecimalSep='.';
SET MoneyFormat='$#,##0.00;-$#,##0.00';
SET TimeFormat='h:mm:ss TT';
SET DateFormat='M/D/YYYY';
SET TimestampFormat='M/D/YYYY h:mm:ss[.fff] TT';
SET FirstWeekDay=6;
SET BrokenWeeks=1;
SET ReferenceDay=0;
SET FirstMonthOfYear=1;
SET CollationLocale='en-US';
SET MonthNames='Jan;Feb;Mar;Apr;May;Jun;Jul;Aug;Sep;Oct;Nov;Dec';
SET LongMonthNames='January;February;March;April;May;June;July;August;September;October;November;December';
SET DayNames='Mon;Tue;Wed;Thu;Fri;Sat;Sun';
SET LongDayNames='Monday;Tuesday;Wednesday;Thursday;Friday;Saturday;Sunday';

///$tab Sources
// Budget (QVD)
Budget:
LOAD
    Year,
    Region,
    Budget,
    Year & '|' & Region AS [%YearRegion]
FROM [lib://DataFiles/Budget.qvd] (qvd);

// Actuals (QVD)
Actuals:
LOAD
    Year,
    Region,
    Actual
FROM [lib://DataFiles/Actuals.qvd] (qvd);

///$tab Transform
// Left join: Actuals -> Budget on Year, Region
LEFT JOIN (Budget)
LOAD
    Year & '|' & Region AS [%YearRegion],
    Actual
RESIDENT Actuals;

///$tab Cleanup
// Drop temporary tables that were only used to build the final model
DROP TABLE Actuals;
"
`;

exports[`links > composite keys: concat and AutoNumber on both sides of a join 2`] = `
"///$tab Main
// Generated by Script Studio for Qlik (https://github.com/muratceme/qlik-script-studio)
// Project: Test
// This script is generated from a visual model. Edit the model and regenerate instead of editing by hand.

// Regional settings (EN)
SET ThousandSep=',';
SET DecimalSep='.';
SET MoneyThousandSep=',';
SET MoneyDecimalSep='.';
SET MoneyFormat='$#,##0.00;-$#,##0.00';
SET TimeFormat='h:mm:ss TT';
SET DateFormat='M/D/YYYY';
SET TimestampFormat='M/D/YYYY h:mm:ss[.fff] TT';
SET FirstWeekDay=6;
SET BrokenWeeks=1;
SET ReferenceDay=0;
SET FirstMonthOfYear=1;
SET CollationLocale='en-US';
SET MonthNames='Jan;Feb;Mar;Apr;May;Jun;Jul;Aug;Sep;Oct;Nov;Dec';
SET LongMonthNames='January;February;March;April;May;June;July;August;September;October;November;December';
SET DayNames='Mon;Tue;Wed;Thu;Fri;Sat;Sun';
SET LongDayNames='Monday;Tuesday;Wednesday;Thursday;Friday;Saturday;Sunday';

///$tab Sources
// Budget (QVD)
Budget:
LOAD
    Year,
    Region,
    Budget,
    AutoNumber(Year & '|' & Region, '%YearRegion') AS [%YearRegion]
FROM [lib://DataFiles/Budget.qvd] (qvd);

// Actuals (QVD)
Actuals:
LOAD
    Actual,
    AutoNumber(Year & '|' & Region, '%YearRegion') AS [%YearRegion]
FROM [lib://DataFiles/Actuals.qvd] (qvd);
"
`;

exports[`links > concatenate appends rows and drops the right table 1`] = `
"///$tab Main
// Generated by Script Studio for Qlik (https://github.com/muratceme/qlik-script-studio)
// Project: Test
// This script is generated from a visual model. Edit the model and regenerate instead of editing by hand.

// Regional settings (EN)
SET ThousandSep=',';
SET DecimalSep='.';
SET MoneyThousandSep=',';
SET MoneyDecimalSep='.';
SET MoneyFormat='$#,##0.00;-$#,##0.00';
SET TimeFormat='h:mm:ss TT';
SET DateFormat='M/D/YYYY';
SET TimestampFormat='M/D/YYYY h:mm:ss[.fff] TT';
SET FirstWeekDay=6;
SET BrokenWeeks=1;
SET ReferenceDay=0;
SET FirstMonthOfYear=1;
SET CollationLocale='en-US';
SET MonthNames='Jan;Feb;Mar;Apr;May;Jun;Jul;Aug;Sep;Oct;Nov;Dec';
SET LongMonthNames='January;February;March;April;May;June;July;August;September;October;November;December';
SET DayNames='Mon;Tue;Wed;Thu;Fri;Sat;Sun';
SET LongDayNames='Monday;Tuesday;Wednesday;Thursday;Friday;Saturday;Sunday';

///$tab Sources
// Sales2023 (QVD)
Sales2023:
LOAD
    OrderID,
    Amount
FROM [lib://DataFiles/Sales2023.qvd] (qvd);

// Sales2024 (QVD)
Sales2024:
LOAD
    OrderID,
    Amount
FROM [lib://DataFiles/Sales2024.qvd] (qvd);

///$tab Transform
// Concatenate: Sales2024 -> Sales2023
CONCATENATE (Sales2023)
LOAD
    OrderID,
    Amount
RESIDENT Sales2024;

///$tab Cleanup
// Drop temporary tables that were only used to build the final model
DROP TABLE Sales2024;
"
`;

exports[`links > renames keys with different names and emits full snapshot 1`] = `
"///$tab Main
// Generated by Script Studio for Qlik (https://github.com/muratceme/qlik-script-studio)
// Project: Test
// This script is generated from a visual model. Edit the model and regenerate instead of editing by hand.

// Regional settings (EN)
SET ThousandSep=',';
SET DecimalSep='.';
SET MoneyThousandSep=',';
SET MoneyDecimalSep='.';
SET MoneyFormat='$#,##0.00;-$#,##0.00';
SET TimeFormat='h:mm:ss TT';
SET DateFormat='M/D/YYYY';
SET TimestampFormat='M/D/YYYY h:mm:ss[.fff] TT';
SET FirstWeekDay=6;
SET BrokenWeeks=1;
SET ReferenceDay=0;
SET FirstMonthOfYear=1;
SET CollationLocale='en-US';
SET MonthNames='Jan;Feb;Mar;Apr;May;Jun;Jul;Aug;Sep;Oct;Nov;Dec';
SET LongMonthNames='January;February;March;April;May;June;July;August;September;October;November;December';
SET DayNames='Mon;Tue;Wed;Thu;Fri;Sat;Sun';
SET LongDayNames='Monday;Tuesday;Wednesday;Thursday;Friday;Saturday;Sunday';

///$tab Sources
// Sales (QVD)
Sales:
LOAD
    OrderID,
    CustomerID,
    ProductID,
    OrderDate,
    Amount
FROM [lib://DataFiles/Sales.qvd] (qvd);

// Customers (QVD)
Customers:
LOAD
    CustID,
    [Customer Name],
    Region
FROM [lib://DataFiles/Customers.qvd] (qvd);

// Products (QVD)
Products:
LOAD
    ProductID,
    [Product Name],
    Region
FROM [lib://DataFiles/Products.qvd] (qvd);

///$tab Transform
// Left join: Customers -> Sales on CustomerID = CustID
LEFT JOIN (Sales)
LOAD
    CustID AS CustomerID,
    [Customer Name],
    Region
RESIDENT Customers;

// Inner join: Products -> Sales on ProductID
INNER JOIN (Sales)
LOAD
    ProductID,
    [Product Name],
    Region
RESIDENT Products;

// Fact (from Sales)
Fact:
NoConcatenate
LOAD
    OrderID,
    [Customer Name],
    [Product Name]
RESIDENT Sales;

///$tab Cleanup
// Drop temporary tables that were only used to build the final model
DROP TABLE Sales;
DROP TABLE Customers;
DROP TABLE Products;
"
`;
