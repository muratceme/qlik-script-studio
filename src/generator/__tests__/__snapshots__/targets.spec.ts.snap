exports[`targets > no GROUP BY without measures; DISTINCT and STORE 1`] = `
"///$tab Main
// Generated by Script Studio for Qlik (https://github.com/muratceme/qlik-script-studio)
// Project: Test
// This script is generated from a visual model. Edit the model and regenerate instead of editing by hand.

// Regional settings (EN)
SET ThousandSep=',';
SET DecimalSep='.';
SET MoneyThousandSep=',';
SET MoneyDecimalSep='.';
SET MoneyFormat='$#,##0.00;-$#,##0.00';
SET TimeFormat='h:mm:ss TT';
SET DateFormat='M/D/YYYY';
SET TimestampFormat='M/D/YYYY h:mm:ss[.fff] TT';
SET FirstWeekDay=6;
SET BrokenWeeks=1;
SET ReferenceDay=0;
SET FirstMonthOfYear=1;
SET CollationLocale='en-US';
SET MonthNames='Jan;Feb;Mar;Apr;May;Jun;Jul;Aug;Sep;Oct;Nov;Dec';
SET LongMonthNames='January;February;March;April;May;June;July;August;September;October;November;December';
SET DayNames='Mon;Tue;Wed;Thu;Fri;Sat;Sun';
SET LongDayNames='Monday;Tuesday;Wednesday;Thursday;Friday;Saturday;Sunday';

///$tab Sources
// Sales (QVD)
Sales:
LOAD
    OrderID,
    CustomerID,
    ProductID,
    OrderDate,
    Amount
FROM [lib://DataFiles/Sales.qvd] (qvd);

// Customers (QVD)
Customers:
LOAD
    CustomerID,
    [Customer Name],
    Region
FROM [lib://DataFiles/Customers.qvd] (qvd);

// Products (QVD)
Products:
LOAD
    ProductID,
    [Product Name],
    Region
FROM [lib://DataFiles/Products.qvd] (qvd);

///$tab Transform
// Customer_List (from Sales)
Customer_List:
NoConcatenate
LOAD DISTINCT
    CustomerID AS Customer
RESIDENT Sales;

// Custom_Path (from Sales)
Custom_Path:
NoConcatenate
LOAD
    OrderID
RESIDENT Sales;

///$tab Store
// Store Customer_List as QVD
STORE Customer_List INTO [lib://QVD/Customer_List.qvd] (qvd);
// Store Custom_Path as QVD
STORE Custom_Path INTO [lib://Archive/orders.qvd] (qvd);

///$tab Cleanup
// Drop temporary tables that were only used to build the final model
DROP TABLE Sales;
"
`;

exports[`targets > renders every calculated-field kind 1`] = `
"///$tab Main
// Generated by Script Studio for Qlik (https://github.com/muratceme/qlik-script-studio)
// Project: Test
// This script is generated from a visual model. Edit the model and regenerate instead of editing by hand.

// Regional settings (EN)
SET ThousandSep=',';
SET DecimalSep='.';
SET MoneyThousandSep=',';
SET MoneyDecimalSep='.';
SET MoneyFormat='$#,##0.00;-$#,##0.00';
SET TimeFormat='h:mm:ss TT';
SET DateFormat='M/D/YYYY';
SET TimestampFormat='M/D/YYYY h:mm:ss[.fff] TT';
SET FirstWeekDay=6;
SET BrokenWeeks=1;
SET ReferenceDay=0;
SET FirstMonthOfYear=1;
SET CollationLocale='en-US';
SET MonthNames='Jan;Feb;Mar;Apr;May;Jun;Jul;Aug;Sep;Oct;Nov;Dec';
SET LongMonthNames='January;February;March;April;May;June;July;August;September;October;November;December';
SET DayNames='Mon;Tue;Wed;Thu;Fri;Sat;Sun';
SET LongDayNames='Monday;Tuesday;Wednesday;Thursday;Friday;Saturday;Sunday';

///$tab Sources
// Sales (QVD)
Sales:
LOAD
    OrderID,
    CustomerID,
    ProductID,
    OrderDate,
    Amount
FROM [lib://DataFiles/Sales.qvd] (qvd);

// Customers (QVD)
Customers:
LOAD
    CustomerID,
    [Customer Name],
    Region
FROM [lib://DataFiles/Customers.qvd] (qvd);

// Products (QVD)
Products:
LOAD
    ProductID,
    [Product Name],
    Region
FROM [lib://DataFiles/Products.qvd] (qvd);

///$tab Transform
// Left join: Customers -> Sales on CustomerID
LEFT JOIN (Sales)
LOAD
    CustomerID,
    [Customer Name],
    Region
RESIDENT Customers;

// Calc (from Sales)
Calc:
NoConcatenate
LOAD
    OrderID,
    [Customer Name] & ' - ' & Region       AS Full,
    [Customer Name] & '!'                  AS [Plain Concat],
    (Amount * 0.8)                         AS Net,
    If(2 <> 0, Amount / 2)                 AS [Per Unit],
    (Amount / 2)                           AS [Plain Div],
    Amount / 1000 * 100                    AS Share,
    If(Amount > 500, 'Large', 'Small')     AS Big,
    If(1 = 1, 1)                           AS Flag,
    Year(OrderDate)                        AS Y,
    'Q' & Ceil(Month(OrderDate) / 3)       AS Q,
    Month(OrderDate)                       AS M,
    MonthName(OrderDate)                   AS MN,
    Week(OrderDate)                        AS W,
    Day(OrderDate)                         AS D,
    WeekDay(OrderDate)                     AS WD,
    Date(MonthStart(OrderDate), 'YYYY-MM') AS YM,
    AutoNumber(OrderID, 'orders')          AS RowKey,
    AutoNumber(OrderID)                    AS RowKey2,
    Upper([Customer Name])                 AS Upper
RESIDENT Sales;

///$tab Cleanup
// Drop temporary tables that were only used to build the final model
DROP TABLE Sales;
DROP TABLE Customers;
"
`;

exports[`targets > renders every filter operator and nested AND/OR groups 1`] = `
"///$tab Main
// Generated by Script Studio for Qlik (https://github.com/muratceme/qlik-script-studio)
// Project: Test
// This script is generated from a visual model. Edit the model and regenerate instead of editing by hand.

// Regional settings (EN)
SET ThousandSep=',';
SET DecimalSep='.';
SET MoneyThousandSep=',';
SET MoneyDecimalSep='.';
SET MoneyFormat='$#,##0.00;-$#,##0.00';
SET TimeFormat='h:mm:ss TT';
SET DateFormat='M/D/YYYY';
SET TimestampFormat='M/D/YYYY h:mm:ss[.fff] TT';
SET FirstWeekDay=6;
SET BrokenWeeks=1;
SET ReferenceDay=0;
SET FirstMonthOfYear=1;
SET CollationLocale='en-US';
SET MonthNames='Jan;Feb;Mar;Apr;May;Jun;Jul;Aug;Sep;Oct;Nov;Dec';
SET LongMonthNames='January;February;March;April;May;June;July;August;September;October;November;December';
SET DayNames='Mon;Tue;Wed;Thu;Fri;Sat;Sun';
SET LongDayNames='Monday;Tuesday;Wednesday;Thursday;Friday;Saturday;Sunday';

///$tab Sources
// Sales (QVD)
Sales:
LOAD
    OrderID,
    CustomerID,
    ProductID,
    OrderDate,
    Amount
FROM [lib://DataFiles/Sales.qvd] (qvd);

// Customers (QVD)
Customers:
LOAD
    CustomerID,
    [Customer Name],
    Region
FROM [lib://DataFiles/Customers.qvd] (qvd);

// Products (QVD)
Products:
LOAD
    ProductID,
    [Product Name],
    Region
FROM [lib://DataFiles/Products.qvd] (qvd);

///$tab Transform
// Left join: Customers -> Sales on CustomerID
LEFT JOIN (Sales)
LOAD
    CustomerID,
    [Customer Name],
    Region
RESIDENT Customers;

// Filtered (from Sales)
Filtered:
NoConcatenate
LOAD
    OrderID,
    [Customer Name]
RESIDENT Sales
WHERE Amount > 100 AND Amount >= 100 AND Amount < 1000 AND Amount <= 1000 AND CustomerID <> 0 AND (Region = 'EU' OR Match(Region, 'TR', 'US') > 0 OR Match(Region, 'XX') = 0 OR Index([Customer Name], 'O''Brien') > 0 OR WildMatch([Customer Name], 'A*') > 0) AND Len(Trim([Customer Name])) > 0 AND Len(Trim(Region)) = 0 AND (OrderDate >= '2024-01-01' AND OrderDate <= '2024-12-31');

///$tab Cleanup
// Drop temporary tables that were only used to build the final model
DROP TABLE Sales;
DROP TABLE Customers;
"
`;

exports[`targets > resident load with automatic GROUP BY from non-aggregated columns 1`] = `
"///$tab Main
// Generated by Script Studio for Qlik (https://github.com/muratceme/qlik-script-studio)
// Project: Test
// This script is generated from a visual model. Edit the model and regenerate instead of editing by hand.

// Regional settings (EN)
SET ThousandSep=',';
SET DecimalSep='.';
SET MoneyThousandSep=',';
SET MoneyDecimalSep='.';
SET MoneyFormat='$#,##0.00;-$#,##0.00';
SET TimeFormat='h:mm:ss TT';
SET DateFormat='M/D/YYYY';
SET TimestampFormat='M/D/YYYY h:mm:ss[.fff] TT';
SET FirstWeekDay=6;
SET BrokenWeeks=1;
SET ReferenceDay=0;
SET FirstMonthOfYear=1;
SET CollationLocale='en-US';
SET MonthNames='Jan;Feb;Mar;Apr;May;Jun;Jul;Aug;Sep;Oct;Nov;Dec';
SET LongMonthNames='January;February;March;April;May;June;July;August;September;October;November;December';
SET DayNames='Mon;Tue;Wed;Thu;Fri;Sat;Sun';
SET LongDayNames='Monday;Tuesday;Wednesday;Thursday;Friday;Saturday;Sunday';

///$tab Sources
// Sales (QVD)
Sales:
LOAD
    OrderID,
    CustomerID,
    ProductID,
    OrderDate,
    Amount
FROM [lib://DataFiles/Sales.qvd] (qvd);

// Customers (QVD)
Customers:
LOAD
    CustomerID,
    [Customer Name],
    Region
FROM [lib://DataFiles/Customers.qvd] (qvd);

// Products (QVD)
Products:
LOAD
    ProductID,
    [Product Name],
    Region
FROM [lib://DataFiles/Products.qvd] (qvd);

///$tab Transform
// Sales_By_Customer (from Sales)
Sales_By_Customer:
NoConcatenate
LOAD
    CustomerID,
    Year(OrderDate)         AS Year,
    Sum(Amount)             AS Total,
    Count(DISTINCT OrderID) AS Orders,
    Avg(Amount)             AS [Avg Amount],
    Min(Amount)             AS Min,
    Max(Amount)             AS Max,
    FirstValue(OrderDate)   AS [First Date],
    LastValue(OrderDate)    AS [Last Date],
    Count(OrderID)          AS Rows
RESIDENT Sales
GROUP BY CustomerID, Year(OrderDate);

///$tab Cleanup
// Drop temporary tables that were only used to build the final model
DROP TABLE Sales;
"
`;
