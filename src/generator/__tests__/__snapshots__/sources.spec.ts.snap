// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`source loads > CSV: delimiters, encodings and headerless files 1`] = `
"///$tab Main
// Generated by Qlik Script Studio (https://github.com/muratceme/qlik-script-studio)
// Project: Test
// This script is generated from a visual model. Edit the model and regenerate instead of editing by hand.

// Regional settings (EN)
SET ThousandSep=',';
SET DecimalSep='.';
SET MoneyThousandSep=',';
SET MoneyDecimalSep='.';
SET MoneyFormat='$#,##0.00;-$#,##0.00';
SET TimeFormat='h:mm:ss TT';
SET DateFormat='M/D/YYYY';
SET TimestampFormat='M/D/YYYY h:mm:ss[.fff] TT';
SET FirstWeekDay=6;
SET BrokenWeeks=1;
SET ReferenceDay=0;
SET FirstMonthOfYear=1;
SET CollationLocale='en-US';
SET MonthNames='Jan;Feb;Mar;Apr;May;Jun;Jul;Aug;Sep;Oct;Nov;Dec';
SET LongMonthNames='January;February;March;April;May;June;July;August;September;October;November;December';
SET DayNames='Mon;Tue;Wed;Thu;Fri;Sat;Sun';
SET LongDayNames='Monday;Tuesday;Wednesday;Thursday;Friday;Saturday;Sunday';

///$tab Sources
// Products (CSV)
Products:
LOAD
    ID,
    Date(Date#([Order Date], 'DD.MM.YYYY')) AS [Order Date],
    Amount                                  AS [Sales Amount]
FROM [lib://DataFiles/Products.csv] (txt, utf8, embedded labels, delimiter is ';', msq);

// Prices (CSV)
Prices:
LOAD
    ID,
    Date(Date#([Order Date], 'DD.MM.YYYY')) AS [Order Date],
    Amount                                  AS [Sales Amount]
FROM [lib://DataFiles/Prices.csv] (txt, unicode, embedded labels, delimiter is '\\t');

// Regions (CSV)
Regions:
LOAD
    @1                            AS ID,
    Date(Date#(@2, 'DD.MM.YYYY')) AS [Order Date],
    @3                            AS [Sales Amount]
FROM [lib://DataFiles/Regions.csv] (txt, codepage is 1252, no labels, delimiter is '|', msq);
"
`;

exports[`source loads > Excel: ooxml with sheet and header offset; biff for .xls 1`] = `
"///$tab Main
// Generated by Qlik Script Studio (https://github.com/muratceme/qlik-script-studio)
// Project: Test
// This script is generated from a visual model. Edit the model and regenerate instead of editing by hand.

// Regional settings (EN)
SET ThousandSep=',';
SET DecimalSep='.';
SET MoneyThousandSep=',';
SET MoneyDecimalSep='.';
SET MoneyFormat='$#,##0.00;-$#,##0.00';
SET TimeFormat='h:mm:ss TT';
SET DateFormat='M/D/YYYY';
SET TimestampFormat='M/D/YYYY h:mm:ss[.fff] TT';
SET FirstWeekDay=6;
SET BrokenWeeks=1;
SET ReferenceDay=0;
SET FirstMonthOfYear=1;
SET CollationLocale='en-US';
SET MonthNames='Jan;Feb;Mar;Apr;May;Jun;Jul;Aug;Sep;Oct;Nov;Dec';
SET LongMonthNames='January;February;March;April;May;June;July;August;September;October;November;December';
SET DayNames='Mon;Tue;Wed;Thu;Fri;Sat;Sun';
SET LongDayNames='Monday;Tuesday;Wednesday;Thursday;Friday;Saturday;Sunday';

///$tab Sources
// Customers (Excel)
Customers:
LOAD
    ID,
    Date(Date#([Order Date], 'DD.MM.YYYY')) AS [Order Date],
    Amount                                  AS [Sales Amount]
FROM [lib://DataFiles/Customers.xlsx] (ooxml, embedded labels, header is 2 lines, table is [Data Sheet]);

// Legacy (Excel)
Legacy:
LOAD
    ID,
    Date(Date#([Order Date], 'DD.MM.YYYY')) AS [Order Date],
    Amount                                  AS [Sales Amount]
FROM [lib://DataFiles/old.xls] (biff, embedded labels, table is [Sheet1$]);
"
`;

exports[`source loads > Inline: plain INLINE, quoted values, preceding LOAD only when renaming 1`] = `
"///$tab Main
// Generated by Qlik Script Studio (https://github.com/muratceme/qlik-script-studio)
// Project: Test
// This script is generated from a visual model. Edit the model and regenerate instead of editing by hand.

// Regional settings (EN)
SET ThousandSep=',';
SET DecimalSep='.';
SET MoneyThousandSep=',';
SET MoneyDecimalSep='.';
SET MoneyFormat='$#,##0.00;-$#,##0.00';
SET TimeFormat='h:mm:ss TT';
SET DateFormat='M/D/YYYY';
SET TimestampFormat='M/D/YYYY h:mm:ss[.fff] TT';
SET FirstWeekDay=6;
SET BrokenWeeks=1;
SET ReferenceDay=0;
SET FirstMonthOfYear=1;
SET CollationLocale='en-US';
SET MonthNames='Jan;Feb;Mar;Apr;May;Jun;Jul;Aug;Sep;Oct;Nov;Dec';
SET LongMonthNames='January;February;March;April;May;June;July;August;September;October;November;December';
SET DayNames='Mon;Tue;Wed;Thu;Fri;Sat;Sun';
SET LongDayNames='Monday;Tuesday;Wednesday;Thursday;Friday;Saturday;Sunday';

///$tab Sources
// Regions (Inline)
Regions:
LOAD * INLINE [
Code, Name
TR, Türkiye
US, "United States, of America"
];

// Flags (Inline)
Flags:
LOAD
    Flag AS IsActive
;
LOAD * INLINE [
Flag
1
];
"
`;

